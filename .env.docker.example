# Copia este archivo a ".env" (mismo directorio que docker-compose.yml) y
# ajusta los valores. "docker compose restart" recarga estos valores sin
# necesidad de reconstruir la imagen.

SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEBUG=False

# Sin HTTPS en esta instalacion local -- necesario para que el login funcione.
USE_HTTPS=False

# Empieza solo con localhost. Cuando sepas la IP de la LAN de esta PC
# (comando "ipconfig", buscar "Direccion IPv4"), agregala aqui separada por
# coma, ej: ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos SQLite dentro del volumen montado (ver docker-compose.yml).
DATABASE_URL=sqlite:////app/dbdata/db.sqlite3

# Sin envio de correo real por ahora: se imprime en los logs del contenedor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Usuario administrador inicial (se crea/actualiza al arrancar el contenedor).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esto-por-una-clave-segura
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_NOMBRE=Administrador
DJANGO_SUPERUSER_APELLIDO=
