# Copia este archivo a ".env" (mismo directorio que manage.py) y ajusta los
# valores. Para que un cambio en ALLOWED_HOSTS (u otra variable) tenga
# efecto, hay que reiniciar el servidor (scripts\start_local.ps1).

SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEBUG=False

# Sin HTTPS en esta instalacion local -- necesario para que el login funcione.
USE_HTTPS=False

# Empieza solo con localhost. Cuando sepas la IP de la LAN de esta PC
# (comando "ipconfig", buscar "Direccion IPv4"), agregala aqui separada por
# coma, ej: ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
ALLOWED_HOSTS=localhost,127.0.0.1

# No hace falta DATABASE_URL: sin esta variable, Django usa automaticamente
# db.sqlite3 en la carpeta del proyecto.

# Sin envio de correo real por ahora: se imprime en la consola del servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Usuario administrador inicial (se crea/actualiza cada vez que arranca el servidor).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esto-por-una-clave-segura
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_NOMBRE=Administrador
DJANGO_SUPERUSER_APELLIDO=
